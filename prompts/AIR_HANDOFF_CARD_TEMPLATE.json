      ],
      "conditional_rules": [
        {
          "id": "HC-COND-ACTIVE-ARTIFACT",
          "condition": "active_artifact.presence_state = PRESENT",
          "requirements": [
            "artifact_id",
            "artifact_revision",
            "task_key",
            "task_center",
            "prior_binding_state",
            "restoration_binding_state",
            "completeness_state",
            "artifact_payload or artifact_ref",
            "sha256 when bytes are available"
          ],
          "failure_behavior": "REVIEW_OR_ARTIFACT_BINDING_RECOVERY"
        },
        {
          "id": "HC-COND-KNOWLEDGE-PATH",
          "condition": "execution_state.execution_benchmark_profile is present for an executable or resumable active artifact",
          "requirements": [
            "execution_benchmark_profile contains domain_knowledge_requirements",
            "execution_benchmark_profile contains cognitive_depth_profile",
            "execution_benchmark_profile contains knowledge_to_execution_path",
            "execution_benchmark_profile contains path_validation_state",
            "execution_state.knowledge_to_execution_path_state matches the canonical benchmark profile",
            "required path stages preserve completion state and evidence references",
            "APPROVE is carried only when path_validation_state = COMPLETE_FOR_ACTIVE_STEP"
          ],
          "failure_behavior": "REVIEW_OR_REJECTED_INSUFFICIENT_PATH"
        },
        {
          "id": "HC-COND-TEST-EVIDENCE",
          "condition": "test_evidence_state.mode = FULL_TEST_EVIDENCE, produced test-evidence references exist, rerun_required_for_full_evidence is true, or a regulatory evidence obligation is OPTIONAL, RECOMMENDED, REQUIRED_FOR_APPROVAL_OR_CLOSURE, SATISFIED, or UNRESOLVED",
          "requirements": [
            "mode is SUMMARY_ONLY or FULL_TEST_EVIDENCE",
            "mode_source and effective_from preserve when the selection became effective",
            "recommendation state and reasons are preserved without silently enabling the mode",
            "regulatory evidence requirement and obligation references are preserved",
            "produced suite or definition, run manifest, per-test result, log, fixture, and README references are preserved when available",
            "each run record declares REPRODUCIBLE_EXECUTABLE, REPLAYABLE_EVALUATION, or MANUAL_REVIEW_REQUIRED",
            "reproducibility limits and sanitization or redaction effects remain visible",
            "a prior SUMMARY_ONLY run sets rerun_required_for_full_evidence when exact evidence was not preserved",
            "missing mandatory regulatory evidence routes to REVIEW or EVIDENCE_REQUIRED"
          ],
          "failure_behavior": "REVIEW_OR_EVIDENCE_REQUIRED"
        },
        {
          "id": "HC-COND-REQUIRED-INPUT",
          "condition": "required_input_state.requests is non-empty or an active/queued task depends on unavailable input, evidence, authority, or action",
          "requirements": [
            "each request has request_id, need_state, input_class, reason_required, controlled_action, current_effect, validation_after_receipt, and satisfaction_state",
            "canonical package, role, and exact filenames are preserved when known",
            "exact_action_requested is preserved for non-file requirements",
            "identity-unresolved requests preserve the smallest resolving question rather than an invented identity",
            "blocking, degraded, received-pending-validation, validated-available-unbound, and satisfied request indexes match request states",
            "safe fallback and acceptable alternatives are preserved when present"
          ],
          "failure_behavior": "REVIEW_OR_EVIDENCE_REQUIRED"
        },
        {
          "id": "HC-COND-ORBIT-1",
          "condition": "orbit_state.orbit_1 is non-empty",
          "requirements": [
            "every entry has artifact identity, task identity, queue_state, pause_or_queue_reason, return_target, resume_condition"
          ],
          "failure_behavior": "REVIEW"
        },
        {
          "id": "HC-COND-ORBIT-2",
          "condition": "orbit_state.orbit_2 is non-empty",
          "requirements": [
            "every entry has artifact identity, task identity, queue_state, dependency_edges, resume_condition"
          ],
          "failure_behavior": "REVIEW"
        },
        {
          "id": "HC-COND-Q4D",
          "condition": "onboarding_state.q4 = D",
          "requirements": [
            "onboarding_state.q4d",
            "working_agreement.q6d_state"
          ],
          "failure_behavior": "LEGACY_Q4_D_BASE_MODE_UNRESOLVED_OR_REVIEW"
        },
        {
          "id": "HC-COND-CREATIVE",
          "condition": "resolved base mode = CREATIVE_NARRATIVE_CONTINUITY",
          "requirements": [
            "onboarding_state.creative_continuity_state when material"
          ],
          "failure_behavior": "REVIEW"
        },
        {
          "id": "HC-COND-APPROVAL",
          "condition": "open_approval_scope is not null",
          "requirements": [
            "approval_scope_id",
            "gate_id",
            "exact_gate_question",
            "requested_action",
            "authorized_action_ids",
            "excluded_action_ids",
            "required_evidence",
            "stop_conditions",
            "expiry_or_completion_condition",
            "approval_state",
            "approval_source"
          ],
          "failure_behavior": "REVIEW_OR_REJECT"
        },
        {
          "id": "HC-COND-GOV",
          "condition": "governance state is material",
          "requirements": [
            "prompt_edition",
            "governance_floor_version",
            "floor_invariant_reference",
            "active_framework_projections",
            "governance_source_rights_state",
            "governance_blockers"
          ],
          "failure_behavior": "REVIEW"
        },
        {
          "id": "HC-COND-SPECIALIST",
          "condition": "specialist or package state is restored",
          "requirements": [
            "identity",
            "version",
            "availability_state",
            "selection_state",
            "validation_state",
            "binding_state",
            "scope"
          ],
          "failure_behavior": "REVIEW"
        },
        {
          "id": "HC-COND-METHOD",
          "condition": "method execution state affects continuation",
          "requirements": [
            "method_id or inline method",
            "active_method_state",
            "active_method_step",
            "method_gate",
            "method_evidence_state",
            "staleness_state"
          ],
          "failure_behavior": "REVIEW"
        },
        {
          "id": "HC-COND-PATCH",
          "condition": "current step is file mutation or patching",
          "requirements": [
            "execution_state.patch_state.source_inventory",
            "source hashes",
            "replacement policy",
            "mutation scope",
            "validation state"
          ],
          "failure_behavior": "EVIDENCE_REQUIRED_OR_REJECT"
        },
        {
          "id": "HC-COND-FILE-RECEIPT",
