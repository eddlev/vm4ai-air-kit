{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:air:authorization-envelope:1",
  "title": "AIR Authorization Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "authorization_id",
    "task_id",
    "issued_at_utc",
    "actor",
    "approval_ref",
    "capabilities",
    "restrictions",
    "default_policy",
    "claim_boundary"
  ],
  "properties": {
    "schema_id": {
      "const": "AIR_AUTHORIZATION_ENVELOPE"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "approval_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspect",
        "modify_worktree",
        "run_tests",
        "commit",
        "push",
        "open_pr",
        "mark_ready",
        "merge",
        "tag",
        "release",
        "publish",
        "destructive_actions"
      ],
      "properties": {
        "inspect": {
          "type": "boolean"
        },
        "modify_worktree": {
          "type": "boolean"
        },
        "run_tests": {
          "type": "boolean"
        },
        "commit": {
          "type": "boolean"
        },
        "push": {
          "type": "boolean"
        },
        "open_pr": {
          "type": "boolean"
        },
        "mark_ready": {
          "type": "boolean"
        },
        "merge": {
          "type": "boolean"
        },
        "tag": {
          "type": "boolean"
        },
        "release": {
          "type": "boolean"
        },
        "publish": {
          "type": "boolean"
        },
        "destructive_actions": {
          "type": "boolean"
        }
      }
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "default_policy": {
      "const": "DENY_UNLESS_TRUE"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": {
            "anyOf": [
              {
                "properties": {
                  "modify_worktree": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "commit": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "push": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "open_pr": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "mark_ready": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "merge": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "tag": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "release": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "publish": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "destructive_actions": {
                    "const": true
                  }
                }
              }
            ]
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "actor": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "^\\s*UNSPECIFIED\\s*$"
            },
            "pattern": "\\S"
          },
          "approval_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "actor",
          "approval_ref"
        ]
      }
    }
  ]
}
