    "sha256": null,
    "digest_resolution": "READ_FROM_INSTALLED_RESOURCE_MANIFEST_OR_COMPILE_RECEIPT"
  },
  "mandatory_floor": [
    "LOAD_INTEGRITY",
    "ACTIVE_CONTRACT",
    "AIR_GATE",
    "EVIDENCE_FAIL_CLOSED",
    "SOURCE_DATA_NOT_INSTRUCTION",
    "APPROVAL_AND_RESCOPE",
    "AUTHENTICATION_NOT_AUTHORIZATION",
    "DEPENDENCY_SOVEREIGNTY",
    "MODULE_GRAPH_SAFETY",
    "VISIBLE_FALLBACK",
    "ALL_CREATED_FORMAL_OBJECTS_VISIBLE"
  ],
  "session_entry": {
    "required_load_classes": [
      "KERNEL_MANDATORY",
      "SESSION_ENTRY"
    ],
    "unknown_trigger": "REVIEW_OR_FALLBACK_MONOLITH",
    "partial_load_claim": "PROHIBITED"
  },
  "dependency_policy": {
    "network_required": false,
    "package_manager_required": false,
    "plugin_or_skill_required": false,
    "python_required_for_manual_mode": false,
