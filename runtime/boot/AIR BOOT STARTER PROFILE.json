  "repository_layout": {
    "path_base": "INSTALLED_RESOURCE_ROOT_OR_EXPLICIT_SOURCE_OVERRIDE",
    "system_prompts": "prompts/",
    "specialist_packages": "profiles/<specialist name>/",
