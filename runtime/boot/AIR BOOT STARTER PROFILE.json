    "cross_host_equivalence": "NOT_CLAIMED",
    "backend_enforcement": "NOT_CLAIMED"
  },
  "fallback_order": [
    "REQUEST_MISSING_LOCAL_MODULE",
    "USE_VALIDATED_LOCAL_BUNDLE",
    "FULL_MONOLITH",
    "EVIDENCE_REQUIRED"
